FROM python:3.11-slim

# Set working directory
WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    gcc \
    default-libmysqlclient-dev \
    pkg-config \
    && rm -rf /var/lib/apt/lists/*

# Copy entire businessCrawler directory
COPY businessCrawler/ /app/

# Install Python dependencies
RUN pip install --no-cache-dir -r requirements.txt

# Create output directory for generated SQL
RUN mkdir -p /output

# Set environment variables
ENV PYTHONUNBUFFERED=1

# Default command runs the init check first, then the crawler
CMD ["sh", "-c", "python init_crawler.py && python business_crawler.py"]
